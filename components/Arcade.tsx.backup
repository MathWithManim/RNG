            <div className="mt-6 text-center text-xs text-gray-500">
              <p>This is just a fun easter egg! Some data is simulated for entertainment.</p>
              <p className="mt-1">Click "System Status" in the header to access again</p>
              <p className="mt-1">Press ESC or click the close button to return.</p>
            </div>
          </div>
        </div>
      ) : game === 'menu' ? (
        <div className="max-w-4xl mx-auto space-y-8">
            <div className="flex items-center gap-4">
                <Button onClick={onBack} variant="secondary" className="px-4 py-3">
                    <ArrowLeft className="w-6 h-6" />
                </Button>
                <div>
                    <h2
                      className="text-3xl font-bold bg-gradient-to-r from-purple-500 to-indigo-500 bg-clip-text text-transparent flex items-center gap-3 cursor-pointer"
                      onClick={triggerEasterEgg}
                      title="System Status"
                    >
                        <Gamepad2 className="w-10 h-10 text-purple-500" />
                        AI Arcade
                    </h2>
                    <p className="text-gray-400">Challenge local neural networks for cash.</p>
                </div>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <GameCard
                    type="ttt"
                    title="Tic-Tac-Toe"
                    subtitle="Vs. Minimax Engine"
                    icon={Brain}
                    styles={{
                        color: 'blue',
                        iconBg: 'bg-blue-500/10',
                        iconColor: 'text-blue-400',
                        textColor: 'text-blue-400',
                        button: 'bg-blue-600',
                        buttonHover: 'hover:bg-blue-500'
                    }}
                    onClick={() => setGame('ttt')}
                />

                <GameCard
                    type="rps"
                    title="RPS AI"
                    subtitle="Vs. Pattern AI"
                    icon={RefreshCw}
                    styles={{
                        color: 'pink',
                        iconBg: 'bg-pink-500/10',
                        iconColor: 'text-pink-400',
                        textColor: 'text-pink-400',
                        button: 'bg-pink-600',
                        buttonHover: 'hover:bg-pink-500'
                    }}
                    onClick={() => setGame('rps')}
                />

                <GameCard
                    type="blackjack"
                    title="Blackjack"
                    subtitle="Vs. Dealer"
                    icon={CreditCard}
                    styles={{
                        color: 'green',
                        iconBg: 'bg-green-500/10',
                        iconColor: 'text-green-400',
                        textColor: 'text-green-400',
                        button: 'bg-green-600',
                        buttonHover: 'hover:bg-green-500'
                    }}
                    onClick={() => setGame('blackjack')}
                />

                <GameCard
                    type="memory"
                    title="Memory Hack"
                    subtitle="Vs. Sequence Gen"
                    icon={Grid}
                    styles={{
                        color: 'yellow',
                        iconBg: 'bg-yellow-500/10',
                        iconColor: 'text-yellow-400',
                        textColor: 'text-yellow-400',
                        button: 'bg-yellow-600',
                        buttonHover: 'hover:bg-yellow-500'
                    }}
                    onClick={() => setGame('memory')}
                />

                <GameCard
                    type="fishing"
                    title="Fishing"
                    subtitle="Catch Rare Fish"
                    icon={Fish}
                    styles={{
                        color: 'blue',
                        iconBg: 'bg-blue-500/10',
                        iconColor: 'text-blue-400',
                        textColor: 'text-blue-400',
                        button: 'bg-blue-600',
                        buttonHover: 'hover:bg-blue-500'
                    }}
                    onClick={() => setGame('fishing')}
                />

                <GameCard
                    type="plinko"
                    title="Plinko"
                    subtitle="Drop & Win"
                    icon={Anchor}
                    styles={{
                        color: 'purple',
                        iconBg: 'bg-purple-500/10',
                        iconColor: 'text-purple-400',
                        textColor: 'text-purple-400',
                        button: 'bg-purple-600',
                        buttonHover: 'hover:bg-purple-500'
                    }}
                    onClick={() => setGame('plinko')}
                />
            </div>
        </div>
      ) : (
        <div className="max-w-2xl mx-auto space-y-8 pb-20">
          <div className="flex items-center justify-between">
              <div className="flex items-center gap-3">
                  <Button onClick={() => setGame('menu')} variant="secondary" className="py-3">
                      <ArrowLeft className="w-5 h-5 mr-2" /> Back to Menu
                  </Button>
                  <button
                    onClick={triggerEasterEgg}
                    className="p-2 rounded-full hover:bg-gray-800 transition-colors duration-300"
                    title="System Status"
                  >
                    <Eye className="w-5 h-5 text-gray-400 hover:text-purple-400" />
                  </button>
              </div>
              <div className="font-mono text-emerald-400 font-bold bg-gray-900 px-4 py-2 rounded-lg border border-emerald-900">
                  Balance: ${formatNumber(balance)}
              </div>
          </div>

          <Card className="p-6">
              {/* Betting UI (Hide during active blackjack/memory hand) */}
              {!(game === 'blackjack' && bjStatus !== 'betting' && bjStatus !== 'gameOver') && !(game === 'memory' && memState.status !== 'idle' && memState.status !== 'fail' && memState.status !== 'success') && (
                <div className="flex flex-col gap-4 mb-8 bg-gray-900/50 p-4 rounded-xl border border-gray-800">
                  {isTroll && (
                    <div className="flex items-center gap-2 text-yellow-500 bg-yellow-900/20 p-2 rounded-lg border border-yellow-500/30">
                      <AlertTriangle className="w-4 h-4" />
                      <span className="text-sm font-medium">Troll Account - Reduced rewards, higher costs</span>
                    </div>
                  )}
                  <div className="flex items-center gap-4">
                    <div className="flex-1">
                        <label className="text-xs text-gray-500 uppercase font-bold mb-1 block">Wager Amount</label>
                        <div className="flex items-center gap-2">
                            <span className="text-emerald-500 font-bold">$</span>
                            <input
                                type="number"
                                value={bet}
                                onChange={handleBetChange}
                                className="bg-transparent border-none text-xl font-bold text-white focus:ring-0 w-full p-0"
                                disabled={game === 'ttt' && board.some(x => x !== null) && gameStatus === 'playing'}
                            />
                        </div>
                      </div>
                      <Button onClick={setMaxBet} variant="secondary" className="text-xs">Max</Button>
                  </div>
                </div>
              )}

              {/* TIC TAC TOE GAME */}
              {game === 'ttt' && (
                  <div className="space-y-6">
                      <div className="flex flex-col items-center">
                          <h3 className="text-xl font-bold mb-2 flex items-center justify-center gap-2">
                              Tic-Tac-Toe
                          </h3>
                          <div className="flex gap-2 mb-4 bg-gray-900 p-1 rounded-lg">
                              {(['easy', 'medium', 'hard', 'impossible'] as TTTDifficulty[]).map(d => (
                                  <button
                                      key={d}
                                      onClick={() => { if(board.every(x => x === null)) setTttDifficulty(d); }}
                                      disabled={!board.every(x => x === null)}
                                      className={`px-3 py-1 text-xs rounded-md capitalize transition-all ${tttDifficulty === d ? 'bg-blue-600 text-white font-bold' : 'text-gray-500 hover:text-gray-300'}`}
                                  >
                                      {d}
                                  </button>
                              ))}
                          </div>

                          <div className="flex items-center gap-2 text-sm text-gray-400 mb-4">
                              {gameStatus === 'playing' ? (
                                  isPlayerTurn ? <span className="text-blue-400 font-bold animate-pulse">Your Turn</span> : <span className="text-red-400 font-bold">AI Thinking...</span>
                              ) : (
                                  <span className="font-bold text-white">Game Over</span>
                              )}
                          </div>
                      </div>

                      <div className="grid grid-cols-3 gap-2 max-w-[300px] mx-auto bg-gray-800 p-2 rounded-2xl">
                          {board.map((cell, i) => {
                              // Visual Animation Logic
                              let cellColor = 'bg-gray-900 hover:bg-gray-700';
                              if (cell === 'X') cellColor = 'bg-blue-500/20 text-blue-400 shadow-blue-900/20';
                              if (cell === 'O') cellColor = 'bg-red-500/20 text-red-400 shadow-red-900/20';

                              let animationClass = '';
                              if (gameStatus === 'won') {
                                  cellColor = 'bg-emerald-500 text-black border-emerald-400 scale-105';
                                  animationClass = 'transition-all duration-500 ease-out';
                              } else if (gameStatus === 'lost') {
                                  cellColor = 'bg-red-600 text-white border-red-500';
                                  animationClass = 'transition-all duration-500 ease-out';
                              }

                              return (
                                  <button
                                      key={i}
                                      onClick={() => handleTTTClick(i)}
                                      disabled={!!cell || gameStatus !== 'playing' || !isPlayerTurn}
                                      className={`aspect-square rounded-xl text-4xl font-black flex items-center justify-center shadow-inner ${cellColor} ${animationClass}`}
                                      style={{ transitionDelay: (gameStatus === 'won' || gameStatus === 'lost') ? `${i * 50}ms` : '0ms' }}
                                  >
                                      {cell === 'X' && <X className="w-12 h-12" />}
                                      {cell === 'O' && <Circle className="w-10 h-10" />}
                                  </button>
                              );
                          })}
                      </div>

                      {gameStatus !== 'playing' && (
                          <div className="text-center animate-in fade-in zoom-in duration-300 bg-gray-900/50 p-4 rounded-xl border border-gray-800">
                              <div className={`text-2xl font-bold mb-2 ${
                                  gameStatus === 'won' ? 'text-emerald-400' :
                                  gameStatus === 'lost' ? 'text-red-400' : 'text-gray-400'
                              }`}>
                                  {gameStatus === 'won' ? 'YOU WON!' :
                                   gameStatus === 'lost' ? 'AI WINS!' : 'DRAW!'}
                              </div>
                              <p className="text-xs text-gray-500 mb-4">
                                  {gameStatus === 'won' ? `Payout: ${tttDifficulty === 'impossible' ? '5x (JACKPOT)' : tttDifficulty === 'hard' ? '2x' : '1.x'}` : gameStatus === 'lost' ? 'Better luck next time' : 'Bet Refunded'}
                              </p>
                              <Button onClick={resetTTT} className="w-full max-w-[200px] bg-blue-600 hover:bg-blue-500">Play Again</Button>
                          </div>
                      )}
                  </div>
              )}

              {/* RPS GAME */}
              {game === 'rps' && (
                  <div className="space-y-8 text-center">
                      <div className="flex justify-between items-start">
                        <div className="text-left">
                            <h3 className="text-xl font-bold text-white">Rock Paper Scissors</h3>
                            <p className="text-xs text-gray-400">Pattern Recognition AI v1.0</p>
                        </div>
                        <div className="text-right flex flex-col items-end">
                            <div className="text-xs text-gray-500 uppercase font-bold mb-1">AI Confidence</div>
                            <div className="flex items-center gap-2">
                                <Gauge className={`w-4 h-4 ${aiConfidence > 70 ? 'text-red-500' : aiConfidence > 40 ? 'text-yellow-500' : 'text-green-500'}`} />
                                <div className="w-24 h-2 bg-gray-800 rounded-full overflow-hidden">
                                    <div
                                        className={`h-full transition-all duration-500 ${aiConfidence > 70 ? 'bg-red-500' : aiConfidence > 40 ? 'bg-yellow-500' : 'bg-green-500'}`}
                                        style={{ width: `${aiConfidence}%` }}
                                    ></div>
                                </div>
                                <span className="text-xs font-mono w-8">{aiConfidence}%</span>
                            </div>
                        </div>
                      </div>

                      {rpsResult && (
                          <div className="flex items-center justify-center gap-4 md:gap-8 py-6 bg-gray-900/50 rounded-xl border border-gray-800 relative overflow-hidden">
                              <div className={`absolute inset-0 opacity-10 ${rpsResult.outcome === 'win' ? 'bg-emerald-500' : rpsResult.outcome === 'lose' ? 'bg-red-500' : 'bg-gray-500'}`}></div>

                              <div className="text-center relative z-10">
                                  <div className="text-xs text-gray-500 mb-2 uppercase tracking-widest">You</div>
                                  <div className="text-5xl animate-in slide-in-from-left-4 duration-300">
                                    {rpsResult.player === 'rock' ? '🪨' : rpsResult.player === 'paper' ? '📄' : '✂️'}
                                  </div>
                              </div>

                              <div className="text-2xl font-black text-gray-700 relative z-10">VS</div>

                              <div className="text-center relative z-10">
                                  <div className="text-xs text-gray-500 mb-2 uppercase tracking-widest flex items-center gap-1 justify-center">
                                      AI <Cpu className="w-3 h-3" />
                                  </div>
                                  <div className="text-5xl animate-in slide-in-from-right-4 duration-300">
                                    {rpsResult.ai === 'rock' ? '🪨' : rpsResult.ai === 'paper' ? '📄' : '✂️'}
                                  </div>
                              </div>
                          </div>
                      )}

                      {rpsResult && (
                          <div className={`text-3xl font-black italic transform -skew-x-6 animate-in fade-in zoom-in duration-300 ${
                              rpsResult.outcome === 'win' ? 'text-emerald-400 drop-shadow-[0_0_10px_rgba(52,211,153,0.5)]' :
                              rpsResult.outcome === 'lose' ? 'text-red-400 drop-shadow-[0_0_10px_rgba(248,113,113,0.5)]' : 'text-gray-400'
                          }`}>
                              {rpsResult.outcome === 'win' ? 'YOU WIN!' :
                               rpsResult.outcome === 'lose' ? 'AI WINS!' : 'DRAW'}
                          </div>
                      )}

                      <div className="grid grid-cols-3 gap-4">
                          {(['rock', 'paper', 'scissors'] as RPSMove[]).map(move => (
                              <button
                                  key={move}
                                  onClick={() => handleRPSPlay(move)}
                                  className="aspect-square rounded-2xl bg-gray-800 hover:bg-gray-700 hover:-translate-y-1 hover:shadow-xl hover:shadow-purple-500/10 transition-all flex flex-col items-center justify-center gap-2 border-2 border-gray-700 hover:border-purple-500 group"
                              >
                                  <div className="text-5xl group-hover:scale-110 transition-transform duration-300">
                                      {move === 'rock' ? '🪨' : move === 'paper' ? '📄' : '✂️'}
                                  </div>
                                  <span className="text-xs font-bold uppercase tracking-wider text-gray-400 group-hover:text-white">
                                      {move}
                                  </span>
                              </button>
                          ))}
                      </div>
                  </div>
              )}

              {/* BLACKJACK GAME */}
              {game === 'blackjack' && (
                  <div className="space-y-8">
                       <div className="text-center">
                          <h3 className="text-xl font-bold text-white mb-2">Cosmic Blackjack</h3>
                          <div className="inline-block px-3 py-1 rounded bg-gray-800 text-xs text-gray-400 border border-gray-700">
                             Dealer stands on 17 • Blackjack pays 3:2
                          </div>
                       </div>

                       {/* Dealer Area */}
                       <div className="space-y-2">
                           <div className="text-xs text-gray-500 font-bold uppercase ml-2">Dealer</div>
                           <div className="flex justify-center gap-2 h-28 md:h-32">
                               {dealerHand.map((card, i) => renderCard(card, i))}
                               {dealerHand.length === 0 && <div className="text-gray-700 flex items-center text-sm">Waiting for deal...</div>}
                           </div>
                           {dealerHand.length > 0 && !dealerHand[1]?.isHidden && (
                               <div className="text-center text-sm font-bold text-gray-400">
                                   Value: {calculateHandValue(dealerHand)}
                               </div>
                           )}
                       </div>

                       {/* Player Area */}
                       <div className="space-y-2">
                           <div className="text-xs text-gray-500 font-bold uppercase ml-2">Player (You)</div>
                           <div className="flex justify-center gap-2 h-28 md:h-32">
                               {playerHand.map((card, i) => renderCard(card, i))}
                               {playerHand.length === 0 && <div className="text-gray-700 flex items-center text-sm">Waiting for deal...</div>}
                           </div>
                           {playerHand.length > 0 && (
                               <div className="text-center text-sm font-bold text-emerald-400">
                                   Value: {calculateHandValue(playerHand)}
                               </div>
                           )}
                       </div>

                        {/* Controls */}
                        <div className="flex justify-center gap-4 mt-8">
                            {bjStatus === 'betting' || bjStatus === 'gameOver' ? (
                                <Button
                                    onClick={startBlackjack}
                                    className="w-full max-w-sm bg-green-600 hover:bg-green-500 shadow-[0_0_20px_rgba(34,197,94,0.3)] animate-pulse"
                                >
                                    {bjStatus === 'gameOver' ? 'Play Again' : 'Deal Cards'}
                                </Button>
                            ) : (
                                <>
                                    <Button
                                        onClick={hit}
                                        disabled={bjStatus !== 'playing'}
                                        className="w-24 bg-blue-600 hover:bg-blue-500"
                                    >
                                        HIT
                                    </Button>
                                    <Button
                                        onClick={() => handleStand()}
                                        disabled={bjStatus !== 'playing'}
                                        className="w-24 bg-red-600 hover:bg-red-500"
                                    >
                                        STAND
                                    </Button>
                                    {playerHand.length === 2 && (
                                        <Button
                                            onClick={doubleDown}
                                            disabled={bjStatus !== 'playing'}
                                            className="w-24 bg-yellow-600 hover:bg-yellow-500"
                                        >
                                            DOUBLE
                                        </Button>
                                    )}
                                </>
                            )}
                        </div>

                        {/* Result Overlay */}
                        {bjStatus === 'gameOver' && bjOutcome && (
                            <div className="text-center animate-in fade-in zoom-in duration-300 bg-gray-900/50 p-4 rounded-xl border border-gray-800 mt-4">
                                <div className={`text-3xl font-black italic transform -skew-x-6 mb-2 ${
                                    bjOutcome === 'win' || bjOutcome === 'blackjack' ? 'text-emerald-400 drop-shadow-[0_0_10px_rgba(52,211,153,0.5)]' :
                                    bjOutcome === 'lose' ? 'text-red-400 drop-shadow-[0_0_10px_rgba(248,113,113,0.5)]' : 'text-gray-400'
                                }`}>
                                    {bjOutcome === 'blackjack' ? 'BLACKJACK!' :
                                     bjOutcome === 'win' ? 'YOU WIN!' :
                                     bjOutcome === 'lose' ? 'HOUSE WINS' : 'PUSH'}
                                </div>
                                <p className="text-sm text-gray-400">
                                    {bjOutcome === 'blackjack' ? `Payout: $${formatNumber(Math.floor(bet * 2.5))}` :
                                     bjOutcome === 'win' ? `Payout: $${formatNumber(bet * 2)}` :
                                     bjOutcome === 'push' ? 'Bet Returned' : 'Better luck next time'}
                                </p>
                            </div>
                        )}
                  </div>
              )}

               {/* MEMORY HACK GAME */}
               {game === 'memory' && (
                  <div className="space-y-6 text-center">
                      <div>
                          <h3 className="text-xl font-bold text-white">Memory Hack</h3>
                          <div className="flex items-center justify-center gap-4 mt-2">
                             <span className="text-sm text-yellow-400 font-mono">Level: {memState.level}</span>
                             <span className="text-sm text-gray-500">Status: {memState.status.toUpperCase()}</span>
                          </div>
                      </div>

                      <div className="grid grid-cols-3 gap-3 max-w-[300px] mx-auto p-4 bg-gray-800/50 rounded-2xl border border-yellow-900/30">
                          {Array.from({ length: 9 }).map((_, i) => {
                                let squareClass = 'bg-gray-900 border-gray-700 hover:border-gray-500';
                                let animationStyle = {};

                                if (activeButton === i) {
                                    squareClass = 'bg-yellow-400 border-yellow-200 shadow-[0_0_15px_rgba(250,204,21,0.6)] scale-95';
                                }

                                if (memState.status === 'success') {
                                    squareClass = 'bg-emerald-500 border-emerald-400 scale-105';
                                    animationStyle = { transitionDelay: `${i * 50}ms`, transitionDuration: '500ms' };
                                } else if (memState.status === 'fail') {
                                    squareClass = 'bg-red-600 border-red-500 scale-95';
                                    animationStyle = { transitionDelay: `${i * 50}ms`, transitionDuration: '500ms' };
                                }

                                return (
                                  <button
                                      key={i}
                                      onClick={() => handleMemoryInput(i)}
                                      disabled={memState.status !== 'input'}
                                      className={`aspect-square rounded-lg border-2 transition-all duration-100 ${squareClass}`}
                                      style={animationStyle}
                                  >
                                  </button>
                                );
                          })}
                      </div>

                      {memState.status === 'idle' && (
                          <Button onClick={startMemoryGame} className="w-full max-w-xs bg-yellow-600 hover:bg-yellow-500">
                             Start Hack Sequence
                          </Button>
                      )}

                      {memState.status === 'fail' && (
                          <div className="animate-in fade-in slide-in-from-top-4">
                              <h4 className="text-red-500 font-bold text-xl mb-2">ACCESS DENIED</h4>
                              <p className="text-gray-400 text-sm mb-4">Sequence broken at level {memState.level}</p>
                              <Button onClick={startMemoryGame} className="w-full max-w-xs bg-red-900/50 hover:bg-red-800 border border-red-500/30 text-red-200">
                                  Retry Hack
                              </Button>
                          </div>
                      )}

                      {memState.status === 'success' && (
                          <div className="animate-in fade-in slide-in-from-top-4">
                              <h4 className="text-emerald-400 font-bold text-xl mb-2">SYSTEM BREACHED</h4>
                              <p className="text-gray-400 text-sm mb-4">You completed all 5 levels!</p>
                              <Button
                                onClick={() => {
                                  // Record successful game for training
                                  setMemoryGameHistory(prev => [...prev, {
                                    sequence: memState.sequence,
                                    playerSequence: memState.playerInput,
                                    success: true
                                  }]);
                                  startMemoryGame();
                                }}
                                className="w-full max-w-xs bg-emerald-600 hover:bg-emerald-500"
                              >
                                  Hack Again
                              </Button>
                          </div>
                      )}

                      {memState.status === 'fail' && (
                          <Button
                            onClick={() => {
                              // Record failed game for training
                              setMemoryGameHistory(prev => [...prev, {
                                sequence: memState.sequence,
                                playerSequence: memState.playerInput,
                                success: false
                              }]);
                              startMemoryGame();
                            }}
                            className="w-full max-w-xs bg-red-900/50 hover:bg-red-800 border border-red-500/30 text-red-200"
                          >
                              Retry Hack
                          </Button>
                      )}

                      <div className="text-xs text-gray-500">
                          Memorize the pattern. Repeat it back. <br/>
                          Payouts increase with sequence length.
                      </div>
                  </div>
              )}

          </Card>
        </div>
      ) : game === 'fishing' ? (
        <div className="max-w-6xl mx-auto">
          <FishingGame
            balance={balance}
            onUpdateBalance={onUpdateBalance}
            onBack={() => setGame('menu')}
          />
        </div>
      ) : game === 'plinko' ? (
        <div className="max-w-6xl mx-auto">
          <PlinkoGame
            balance={balance}
            onUpdateBalance={onUpdateBalance}
            onBack={() => setGame('menu')}
          />
        </div>
      )}
    </>
  );
            onBack={() => setGame('menu')}
          />
        </div>
      )}
    </>
  );
            onBack={() => setGame('menu')}
          />
        </div>
      )}
    </>
  );

  // Train models when component unmounts
  useEffect(() => {
    return () => {
      // Train models with session data when leaving
      trainModels();
    };
  }, []);
}

export default Arcade;
