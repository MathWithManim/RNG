
'use client';
import React, { useState, useEffect } from 'react';
import { ArrowLeft, Gamepad2, Brain, X, Circle, RefreshCw, Cpu, Gauge, Spade, Heart, Club, Diamond, CreditCard, Grid, Zap, Lock, Eye, EyeOff, AlertTriangle, Fish, Anchor } from 'lucide-react';
import { Card, Button, formatNumber, calculateLevel } from './Shared';
import { soundEngine } from '../services/soundEngine';
import { checkTTTWinner, getBestTTTMove, predictRPSMove, createDeck, calculateHandValue, generateMemorySequence } from '../services/aiEngine';
import enhancedArcadeAI from '../services/enhancedAI';
import { RPSMove, TTTDifficulty, Card as CardType, MemoryGameState, Stats } from '../types';
import FishingGame from './FishingGame';
import PlinkoGame from './PlinkoGame';

interface ArcadeProps {
  balance: number;
  onUpdateBalance: (amount: number) => void;
  onBack: () => void;
  stats: Stats;
  isAdmin: boolean;
  isBanned?: boolean;
  isTroll?: boolean;
}

type GameType = 'menu' | 'ttt' | 'rps' | 'blackjack' | 'memory' | 'fishing' | 'plinko';

const Arcade: React.FC<ArcadeProps> = ({ balance, onUpdateBalance, onBack, stats, isAdmin, isBanned = false, isTroll = false }) => {
  const [game, setGame] = useState<GameType>('menu');
  const [bet, setBet] = useState<number>(100);

  // If user is banned, show ban message and prevent gameplay
  if (isBanned) {
    return (
      <div className="min-h-screen flex items-center justify-center p-4">
        <Card className="max-w-md text-center">
          <div className="flex flex-col items-center gap-4">
            <div className="p-3 bg-red-500/20 rounded-full">
              <AlertTriangle className="w-12 h-12 text-red-500" />
            </div>
            <h2 className="text-xl font-bold text-red-500">Account Banned</h2>
            <p className="text-gray-400">Your account has been banned and you cannot access the arcade.</p>
            <Button onClick={onBack} className="mt-4">
              <ArrowLeft className="w-4 h-4 mr-2" />
              Back to Dashboard
            </Button>
          </div>
        </Card>
      </div>
    );
  }

  // If user is a troll, apply special behavior
  const trollMultiplier = isTroll ? 0.5 : 1; // Troll users get 50% of normal rewards
  const trollPenalty = isTroll ? 1.5 : 1; // Troll users pay 1.5x for bets

  // Play troll sound effect when component mounts if user is a troll
  useEffect(() => {
    if (isTroll) {
      soundEngine.playTrollEffect();
    }
  }, [isTroll]);

  // --- TIC TAC TOE STATE ---
  const [board, setBoard] = useState<(string | null)[]>(Array(9).fill(null));
  const [isPlayerTurn, setIsPlayerTurn] = useState(true);
  const [gameStatus, setGameStatus] = useState<'playing' | 'won' | 'lost' | 'draw'>('playing');
  const [tttDifficulty, setTttDifficulty] = useState<TTTDifficulty>('hard');

  // --- RPS STATE ---
  const [rpsHistory, setRpsHistory] = useState<Record<string, Record<string, number>>>({
      rock: { rock: 0, paper: 0, scissors: 0 },
      paper: { rock: 0, paper: 0, scissors: 0 },
      scissors: { rock: 0, paper: 0, scissors: 0 }
  });
  const [lastPlayerMove, setLastPlayerMove] = useState<RPSMove | null>(null);
  const [rpsResult, setRpsResult] = useState<{player: RPSMove, ai: RPSMove, outcome: 'win'|'lose'|'draw'} | null>(null);
  const [aiConfidence, setAiConfidence] = useState<number>(0);
  const [rpsGameHistory, setRpsGameHistory] = useState<Array<{playerMove: RPSMove, aiMove: RPSMove, outcome: 'win' | 'lose' | 'draw'}>>([]);
  const [tttGameHistory, setTttGameHistory] = useState<Array<{board: (string | null)[], move: number}>>([]);
  const [memoryGameHistory, setMemoryGameHistory] = useState<Array<{sequence: number[], playerSequence: number[], success: boolean}>>([]);

  // --- BLACKJACK STATE ---
  const [deck, setDeck] = useState<CardType[]>([]);
  const [playerHand, setPlayerHand] = useState<CardType[]>([]);
  const [dealerHand, setDealerHand] = useState<CardType[]>([]);
  const [bjStatus, setBjStatus] = useState<'betting' | 'playing' | 'dealerTurn' | 'gameOver'>('betting');
  const [bjOutcome, setBjOutcome] = useState<'win' | 'lose' | 'push' | 'blackjack' | null>(null);

  // --- MEMORY HACK STATE ---
  const [memState, setMemState] = useState<MemoryGameState>({
      sequence: [],
      playerInput: [],
      status: 'idle',
      level: 1
  });
  const [activeButton, setActiveButton] = useState<number | null>(null);

  useEffect(() => {
    enhancedArcadeAI.initializeModels();
  }, []);

  // --- PROGRESSION ---
  const currentLevel = calculateLevel(stats.xp);
  
  const GAME_UNLOCKS = {
      ttt: 1,
      rps: 3,
      blackjack: 5,
      memory: 8
  };

  const isUnlocked = (type: keyof typeof GAME_UNLOCKS) => {
      if (isAdmin) return true;
      return currentLevel >= GAME_UNLOCKS[type];
  };

  // --- BETTING HELPERS ---
  const handleBetChange = (e: React.ChangeEvent<HTMLInputElement>) => {
      setBet(Math.max(0, Math.min(balance, parseInt(e.target.value) || 0)));
  };

  const setMaxBet = () => setBet(balance);

  // ==========================================
  // TIC TAC TOE LOGIC
  // ==========================================
  
  const handleTTTClick = (i: number) => {
      if (board[i] || gameStatus !== 'playing' || !isPlayerTurn) return;

      if (balance < bet * trollPenalty) {
          soundEngine.playError();
          alert("Insufficient funds!");
          return;
      }

      // 1. Player Move
      if (board.every(x => x === null)) {
          const trollAdjustedBet = Math.floor(bet * trollPenalty); // Troll pays more
          onUpdateBalance(-trollAdjustedBet); // Deduct bet on first move
          soundEngine.playClick(); // Play sound when placing first bet
      }

      const newBoard = [...board];
      newBoard[i] = 'X';
      setBoard(newBoard);
      soundEngine.playMenuSelect(); // Different sound for game move

      // Record the move for training
      setTttGameHistory(prev => [...prev, { board: [...newBoard], move: i }]);

      const winner = checkTTTWinner(newBoard);
      if (winner) {
          finishTTT('won');
          return;
      }
      if (!newBoard.includes(null)) {
          finishTTT('draw');
          return;
      }

      // 2. AI Move
      setIsPlayerTurn(false);
      setTimeout(async () => {
          let aiMoveIndex = -1;

          if (typeof window !== 'undefined' && 'tf' in window) {
              aiMoveIndex = enhancedArcadeAI.predictTicTacToeMove(newBoard, tttDifficulty);
          } else {
              aiMoveIndex = getBestTTTMove(newBoard, tttDifficulty);
          }

          if (aiMoveIndex !== -1) {
              newBoard[aiMoveIndex] = 'O';
              setBoard(newBoard);
              soundEngine.playMenuSelect(); // Sound for AI move

              // Record the AI move for training
              setTttGameHistory(prev => [...prev, { board: [...newBoard], move: aiMoveIndex }]);

              const aiWinner = checkTTTWinner(newBoard);
              if (aiWinner) {
                  finishTTT('lost');
              } else if (!newBoard.includes(null)) {
                  finishTTT('draw');
              } else {
                  setIsPlayerTurn(true);
              }
          }
      }, 500);
  };

  const finishTTT = (result: 'won' | 'lost' | 'draw') => {
      setGameStatus(result);
      if (result === 'won') {
          // Multipliers based on difficulty
          let mult = 2;
          if (tttDifficulty === 'easy') mult = 1.2;
          if (tttDifficulty === 'medium') mult = 1.5;
          if (tttDifficulty === 'hard') mult = 2.0;
          if (tttDifficulty === 'impossible') mult = 5.0; // Good luck

          const trollAdjustedReward = Math.floor(bet * mult * trollMultiplier); // Troll gets less reward
          onUpdateBalance(trollAdjustedReward);
          soundEngine.playWin();
      } else if (result === 'lost') {
          soundEngine.playLose();
      } else if (result === 'draw') {
          const trollAdjustedRefund = Math.floor(bet * trollMultiplier); // Troll gets partial refund
          onUpdateBalance(trollAdjustedRefund); // Refund
          soundEngine.playNotification(); // Sound for draw
      }
  };

  const resetTTT = () => {
      setBoard(Array(9).fill(null));
      setGameStatus('playing');
      setIsPlayerTurn(true);
  };


  // ==========================================
  // RPS LOGIC
  // ==========================================

  const handleRPSPlay = (playerMove: RPSMove) => {
      if (balance < bet * trollPenalty) {
          soundEngine.playError();
          return;
      }

      // Play sound for making a move
      soundEngine.playMenuSelect();

      // 1. AI Predicts BEFORE updating history (to simulate real prediction)
      let aiMove: RPSMove;
      let confidence = 0;

      if (typeof window !== 'undefined' && 'tf' in window) {
          const predictedMove = enhancedArcadeAI.predictRPSMove(
              rpsHistory.player ? Object.keys(rpsHistory.player) as RPSMove[] : [],
              rpsHistory.ai ? Object.keys(rpsHistory.ai) as RPSMove[] : []
          );
          aiMove = predictedMove;
          confidence = Math.floor(Math.random() * 30) + 50; // Placeholder confidence
      } else {
          const prediction = predictRPSMove(rpsHistory, lastPlayerMove);
          aiMove = prediction.move;
          confidence = prediction.confidence;
      }

      setAiConfidence(confidence);

      // 2. Determine Winner
      let result: 'win' | 'lose' | 'draw' = 'draw';
      if (playerMove === aiMove) result = 'draw';
      else if (
          (playerMove === 'rock' && aiMove === 'scissors') ||
          (playerMove === 'paper' && aiMove === 'rock') ||
          (playerMove === 'scissors' && aiMove === 'paper')
      ) {
          result = 'win';
      } else {
          result = 'lose';
      }

      // 3. Handle Money
      if (result === 'win') {
          const trollAdjustedReward = Math.floor(bet * trollMultiplier); // Troll gets less reward
          onUpdateBalance(trollAdjustedReward); // Profit (bet is technically kept, plus win amount)
          soundEngine.playWin();
      } else if (result === 'lose') {
          const trollAdjustedBet = Math.floor(bet * trollPenalty); // Troll pays more
          onUpdateBalance(-trollAdjustedBet);
          soundEngine.playLose();
      } else { // Draw
          soundEngine.playNotification();
      }

      // 4. Update History for NEXT prediction
      if (lastPlayerMove) {
          setRpsHistory(prev => ({
              ...prev,
              [lastPlayerMove]: {
                  ...prev[lastPlayerMove],
                  [playerMove]: prev[lastPlayerMove][playerMove] + 1
              }
          }));
      }
      setLastPlayerMove(playerMove);
      setRpsResult({ player: playerMove, ai: aiMove, outcome: result });

      // Update game history for enhanced AI training
      setRpsGameHistory(prev => [...prev, { playerMove: playerMove, aiMove: aiMove, outcome: result }]);
  };

  // Function to train models with collected data
  const trainModels = async () => {
    console.log('Training models with collected gameplay data...');

    try {
      // Train Tic-Tac-Toe model
      if (tttGameHistory.length > 0) {
        await enhancedArcadeAI.trainTicTacToeModel(tttGameHistory);
      }

      // Train RPS model
      if (rpsGameHistory.length > 0) {
        await enhancedArcadeAI.trainRPSModel(rpsGameHistory);
      }

      // Train Memory model
      if (memoryGameHistory.length > 0) {
        await enhancedArcadeAI.trainMemoryModel(memoryGameHistory);
      }

      console.log('Models trained successfully!');
    } catch (error) {
      console.error('Error training models:', error);
    }
  };

  // ==========================================
  // BLACKJACK LOGIC
  // ==========================================

  const startBlackjack = () => {
      if (balance < bet * trollPenalty) {
          soundEngine.playError();
          return; // Check if user has enough with troll penalty
      }
      const trollAdjustedBet = Math.floor(bet * trollPenalty); // Troll pays more
      onUpdateBalance(-trollAdjustedBet);
      soundEngine.playMenuSelect(); // Use more appropriate sound for game start

      const newDeck = createDeck();
      // Deal initial cards
      const pHand = [newDeck.pop()!, newDeck.pop()!];
      const dHand = [newDeck.pop()!, { ...newDeck.pop()!, isHidden: true }];

      setDeck(newDeck);
      setPlayerHand(pHand);
      setDealerHand(dHand);
      setBjStatus('playing');
      setBjOutcome(null);

      // Check for instant blackjack
      const pVal = calculateHandValue(pHand);
      if (pVal === 21) {
          handleStand(pHand, dHand, newDeck, true); // Pass true to indicate natural BJ check
      }
  };

  const hit = () => {
      const newDeck = [...deck];
      const card = newDeck.pop()!;
      const newHand = [...playerHand, card];
      setPlayerHand(newHand);
      setDeck(newDeck);
      soundEngine.playMenuSelect(); // Card draw sound

      if (calculateHandValue(newHand) > 21) {
          setBjStatus('gameOver');
          setBjOutcome('lose'); // Bust
          soundEngine.playLose(); // Bust sound
      }
  };

  const handleStand = (
      pHand = playerHand, 
      dHand = dealerHand, 
      currentDeck = deck, 
      isNatural = false
    ) => {
      setBjStatus('dealerTurn');
      
      // Reveal dealer card
      let newDealerHand = dHand.map(c => ({ ...c, isHidden: false }));
      let newDeck = [...currentDeck];

      // Process dealer moves immediately (visual delay can be added but logic is instant)
      let dVal = calculateHandValue(newDealerHand);

      // Dealer hits on soft 17 rule usually, here we just say hit < 17
      while (dVal < 17) {
          const card = newDeck.pop()!;
          newDealerHand = [...newDealerHand, { ...card, isHidden: card.isHidden || false }];
          dVal = calculateHandValue(newDealerHand);
      }

      setDealerHand(newDealerHand);
      setDeck(newDeck);

      // Determine Winner
      const pVal = calculateHandValue(pHand);
      
      setTimeout(() => {
          setBjStatus('gameOver');
          if (dVal > 21) {
              setBjOutcome(isNatural ? 'blackjack' : 'win');
              if (isNatural) {
                  const trollAdjustedReward = Math.floor(bet * 2.5 * trollMultiplier); // Troll gets less reward
                  onUpdateBalance(trollAdjustedReward);
              } else {
                  const trollAdjustedReward = Math.floor(bet * 2 * trollMultiplier); // Troll gets less reward
                  onUpdateBalance(trollAdjustedReward);
              }
              soundEngine.playWin();
          } else if (pVal > dVal) {
              setBjOutcome(isNatural ? 'blackjack' : 'win');
               if (isNatural) {
                   const trollAdjustedReward = Math.floor(bet * 2.5 * trollMultiplier); // Troll gets less reward
                   onUpdateBalance(trollAdjustedReward);
               } else {
                   const trollAdjustedReward = Math.floor(bet * 2 * trollMultiplier); // Troll gets less reward
                   onUpdateBalance(trollAdjustedReward);
               }
               soundEngine.playWin();
          } else if (pVal === dVal) {
              setBjOutcome('push');
              const trollAdjustedRefund = Math.floor(bet * trollMultiplier); // Troll gets partial refund
              onUpdateBalance(trollAdjustedRefund);
              soundEngine.playNotification(); // Push/draw sound
          } else {
              setBjOutcome('lose');
              soundEngine.playLose();
          }
      }, 500);
  };

  const doubleDown = () => {
      const trollAdjustedBet = Math.floor(bet * trollPenalty); // Troll pays more
      if (balance < trollAdjustedBet) {
          soundEngine.playError();
          alert("Not enough balance to double!");
          return;
      }
      onUpdateBalance(-trollAdjustedBet); // Add another bet with troll penalty
      soundEngine.playPowerUp(); // Double down sound

      const newDeck = [...deck];
      const card = newDeck.pop()!;
      const newHand = [...playerHand, card];
      setPlayerHand(newHand);
      setDeck(newDeck);
      soundEngine.playMenuSelect(); // Card draw sound

      if (calculateHandValue(newHand) > 21) {
          setBjStatus('gameOver');
          setBjOutcome('lose');
          soundEngine.playLose(); // Bust sound
      } else {
          handleStand(newHand, dealerHand, newDeck);
          setBet(b => b * 2);
      }
  };

  // ==========================================
  // MEMORY HACK LOGIC
  // ==========================================
  
  const startMemoryGame = () => {
      const trollAdjustedBet = Math.floor(bet * trollPenalty); // Troll pays more
      if (balance < trollAdjustedBet) {
          soundEngine.playError();
          return;
      }
      onUpdateBalance(-trollAdjustedBet);
      soundEngine.playMenuSelect(); // Start game sound

      let newSequence: number[];
      if (typeof window !== 'undefined' && 'tf' in window) {
          newSequence = generateMemorySequence(3);
      } else {
          newSequence = generateMemorySequence(3);
      }

      setMemState({
          sequence: newSequence,
          playerInput: [],
          status: 'idle',
          level: 1
      });

      playSequence(newSequence);
  };

  const playSequence = (seq: number[]) => {
      setMemState(prev => ({ ...prev, sequence: seq, status: 'showing', playerInput: [] }));

      let i = 0;
      const interval = setInterval(() => {
          if (i >= seq.length) {
              clearInterval(interval);
              setActiveButton(null);
              setMemState(prev => ({ ...prev, status: 'input' }));
              soundEngine.playNotification(); // Sequence finished sound
              return;
          }

          setActiveButton(seq[i]);
          soundEngine.playAmbient(); // Use ambient sound for sequence

          setTimeout(() => {
              setActiveButton(null);
          }, 300);

          i++;
      }, 600);
  };

  const handleMemoryInput = (index: number) => {
      if (memState.status !== 'input') return;

      // Flash button
      setActiveButton(index);
      soundEngine.playMenuSelect(); // Use menu select sound for input
      setTimeout(() => setActiveButton(null), 150);

      const newInput = [...memState.playerInput, index];
      setMemState(prev => ({ ...prev, playerInput: newInput }));

      // Check if wrong
      if (newInput[newInput.length - 1] !== memState.sequence[newInput.length - 1]) {
          setMemState(prev => ({ ...prev, status: 'fail' }));
          soundEngine.playError(); // Error sound for wrong input
          return;
      }

      // Check if complete
      if (newInput.length === memState.sequence.length) {
          // Round Complete
          const payout = Math.floor(bet * (1.5)); // 50% profit per round?
          const trollAdjustedPayout = Math.floor(payout * trollMultiplier); // Troll gets less reward
          onUpdateBalance(trollAdjustedPayout); // Give back partial with troll penalty

          if (memState.level >= 5) {
             // Win Game
             setMemState(prev => ({ ...prev, status: 'success' }));
             soundEngine.playWin(); // Win sound instead of achievement
          } else {
             // Next Level
             soundEngine.playSuccess(); // Success sound for advancing
             setTimeout(() => {
                 const nextLevel = memState.level + 1;
                 let nextSequence: number[];

                 if (typeof window !== 'undefined' && 'tf' in window) {
                     const predictedNext = enhancedArcadeAI.predictMemorySequence(memState.sequence);
                     nextSequence = [...memState.sequence, predictedNext];
                     for (let i = memState.sequence.length + 1; i < nextLevel + 2; i++) {
                         nextSequence = [...nextSequence, Math.floor(Math.random() * 9)];
                     }
                 } else {
                     nextSequence = generateMemorySequence(nextLevel + 2);
                 }

                 setMemState(prev => ({ ...prev, level: nextLevel }));
                 playSequence(nextSequence);
             }, 1000);
          }
      } else {
          soundEngine.playNotification(); // Sound for correct input but not complete
      }
  };


  // --- RENDER HELPERS ---
  const renderCard = (card: CardType, index: number) => {
      if (card.isHidden) {
          return (
              <div key={index} className="w-16 h-24 md:w-20 md:h-28 bg-blue-900 border-2 border-blue-400 rounded-lg flex items-center justify-center shadow-xl transform hover:-translate-y-2 transition-transform bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')]">
                  <div className="w-10 h-10 rounded-full border-2 border-blue-400/30 flex items-center justify-center">
                     <Gamepad2 className="text-blue-400/50" />
                  </div>
              </div>
          );
      }

      const isRed = card.suit === 'hearts' || card.suit === 'diamonds';
      const SuitIcon = card.suit === 'hearts' ? Heart : card.suit === 'diamonds' ? Diamond : card.suit === 'clubs' ? Club : Spade;

      return (
          <div key={index} className="w-16 h-24 md:w-20 md:h-28 bg-gray-100 rounded-lg flex flex-col justify-between p-2 shadow-xl transform hover:-translate-y-2 transition-transform text-gray-900">
              <div className={`text-sm font-bold flex flex-col items-center leading-none ${isRed ? 'text-red-600' : 'text-slate-900'}`}>
                  <span>{card.rank}</span>
                  <SuitIcon className="w-3 h-3" fill="currentColor" />
              </div>
              <div className={`self-center ${isRed ? 'text-red-600' : 'text-slate-900'}`}>
                   <SuitIcon className="w-6 h-6" fill="currentColor" />
              </div>
               <div className={`text-sm font-bold flex flex-col items-center leading-none transform rotate-180 ${isRed ? 'text-red-600' : 'text-slate-900'}`}>
                  <span>{card.rank}</span>
                  <SuitIcon className="w-3 h-3" fill="currentColor" />
              </div>
          </div>
      );
  };

  const GameCard = ({ type, title, subtitle, icon: Icon, styles, onClick }: any) => {
      const unlocked = isUnlocked(type);
      const reqLevel = GAME_UNLOCKS[type as keyof typeof GAME_UNLOCKS];

      return (
          <Card className={`transition-all group relative overflow-hidden ${unlocked ? `hover:border-${styles.color}-500 cursor-pointer` : 'opacity-70 border-gray-800'}`}>
              <div onClick={unlocked ? onClick : undefined} className="p-4 text-center space-y-4 h-full flex flex-col">
                  {!unlocked && (
                      <div className="absolute inset-0 bg-black/60 z-20 flex flex-col items-center justify-center backdrop-blur-[2px]">
                          <Lock className="w-12 h-12 text-gray-500 mb-2" />
                          <span className="font-bold text-gray-400">Locked</span>
                          <span className="text-xs text-red-400 font-mono mt-1">Requires Level {reqLevel}</span>
                      </div>
                  )}
                  {/* Explicit class definitions instead of dynamic bg-${color}-500/10 */}
                  <div className={`w-20 h-20 mx-auto rounded-full flex items-center justify-center group-hover:scale-110 transition-transform ${styles.iconBg} ${styles.iconColor}`}>
                      <Icon className="w-10 h-10" />
                  </div>
                  <div className="flex-1">
                      <h3 className="text-xl font-bold text-white">{title}</h3>
                      <p className="text-sm text-gray-400 mt-2">{subtitle}</p>
                      <p className={`text-xs mt-1 opacity-70 ${styles.textColor}`}>Level {reqLevel}+</p>
                  </div>
                  <Button disabled={!unlocked} className={`w-full ${styles.button} ${styles.buttonHover}`}>
                      Play
                  </Button>
              </div>
          </Card>
      );
  }

  // Easter egg: Information display
  const [showEasterEgg, setShowEasterEgg] = useState(false);
  const [userInfo, setUserInfo] = useState({
    ip: '192.168.1.1',
    userAgent: 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
    platform: 'Win32',
    language: 'en-US',
    timezone: 'UTC-05:00',
    screenRes: '1920x1080',
    location: 'Unknown',
    connection: 'WiFi',
    device: 'Desktop',
    locationAccuracy: 'Unknown',
    lastSeen: 'Unknown',
    sessionId: 'Unknown',
    deviceId: 'Unknown',
    fingerprint: 'Unknown',
    cookies: 'Unknown',
    browserVersion: 'Unknown',
    onlineStatus: 'Unknown',
    doNotTrack: 'Unknown',
    hardwareConcurrency: 'Unknown',
    deviceMemory: 'Unknown',
    batteryLevel: 'Unknown',
    timezoneOffset: 0,
    referrer: 'Unknown',
    installedFonts: 'Unknown',
    // Additional enhanced data
    cpuModel: 'Unknown',
    gpuModel: 'Unknown',
    ramSize: 'Unknown',
    storageSize: 'Unknown',
    batteryStatus: 'Unknown',
    networkSpeed: 'Unknown',
    screenOrientation: 'Unknown',
    screenDensity: 'Unknown',
    screenRefreshRate: 'Unknown',
    keyboardLayout: 'Unknown',
    activeTabTitle: 'Unknown',
    activeTabUrl: 'Unknown',
    systemTheme: 'Unknown',
    accessibilityFeatures: 'Unknown',
    fontSmoothing: 'Unknown',
    trackingProtection: 'Unknown',
    doNotTrackStatus: 'Unknown',
    adBlockerStatus: 'Unknown',
    browserExtensions: 'Unknown',
    activeWindows: 'Unknown',
    openTabs: 'Unknown',
    systemUptime: 'Unknown',
    cpuUsage: 'Unknown',
    memoryUsage: 'Unknown',
    diskUsage: 'Unknown',
    networkActivity: 'Unknown',
    lastReboot: 'Unknown',
    systemVersion: 'Unknown',
    antivirus: 'Unknown',
    firewallStatus: 'Unknown',
    remoteAccess: 'Unknown',
    clipboardContent: 'Unknown',
    clipboardHistory: 'Unknown',
    recentApps: 'Unknown',
    recentFiles: 'Unknown',
    downloadSpeed: 'Unknown',
    uploadSpeed: 'Unknown',
    ping: 'Unknown',
    dnsProvider: 'Unknown',
    macAddress: 'Unknown',
    networkInterfaces: 'Unknown',
    routerModel: 'Unknown',
